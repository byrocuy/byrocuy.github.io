---
// TRACE PAPER journal — /blog (PLAN §4.1, §3.4, M4.1).
// Ledger of all posts (PostCard rows) under a mono-caps
// POST / DATE / TAG header. Per-tag pages live at /blog/tags/[tag]
// (static, built at deploy time), so every chip is a plain link to
// its static page — no query strings, no client JS, static-host safe.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Reading time from the raw body (code fences + markup stripped, ~220 wpm).
const readingTimeOf = (p: CollectionEntry<'posts'>) => {
  const text = p.body ?? ''
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>_`~()[\]|]/g, ' ');
  return Math.max(1, Math.round(text.trim().split(/\s+/).filter(Boolean).length / 220));
};

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = allPosts;

const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.data.tags) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b));

const tagHref = (tag: string) =>
  `/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`;
const resetHref = '/blog/';
---
<BaseLayout
  title="Journal — TRACE PAPER"
  current="journal"
  description="The TRACE PAPER journal — measurement notes from an AI engineer."
>
  <div class="page">
    <header class="journal-head">
      <p class="mono-label">Journal · Measurement Logbook</p>
      <h1>Journal</h1>
      <p class="journal-sub">
        All measurements, date-descending. Tap a tag for its per-tag page.
      </p>
    </header>

    <nav class="tag-filter" aria-label="Browse journal tags">
      <a class="tag-chip" href={resetHref}>All posts</a>
      {allTags.map((t) => (
        <a class="tag-chip" href={tagHref(t)}>
          {t} <span class="tag-chip__count tnum">×{tagCounts.get(t)}</span>
        </a>
      ))}
    </nav>

    {posts.length > 0 ? (
      <div class="ledger">
        <div class="ledger__head">
          <span class="ledger__caption">POST / DATE / TAG</span>
        </div>
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            readingTime={readingTimeOf(post)}
            href={`/blog/${post.id}/`}
            tagHref={tagHref}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-state__code mono-label">NO SUCH MEASUREMENT</p>
        <p class="empty-state__note">
          No measurements yet. <a href={resetHref}>Show all posts →</a>
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .journal-head {
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--hairline);
  }
  .journal-head .mono-label {
    display: block;
    margin-bottom: var(--s1);
  }
  .journal-head h1 {
    font-size: var(--step-4);
  }
  .journal-sub {
    margin-top: var(--s3);
    color: var(--ink-700);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    padding: var(--s4) 0 var(--s2);
    border-bottom: 1px solid var(--hairline);
  }
  .tag-chip {
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-700);
    text-decoration: none;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    padding: 0.4em 0.7em;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .tag-chip:hover {
    color: var(--accent-600);
    border-color: var(--accent-600);
  }
  .tag-chip__count {
    color: var(--ink-500);
    margin-left: 0.35em;
  }

  .ledger {
    margin-top: var(--s2);
  }
  .ledger__caption {
    grid-column: 1 / -1; /* single spanning caption over the row grid */
  }

  .empty-state {
    padding: var(--s8) var(--s4);
    text-align: center;
  }
  .empty-state__code {
    color: var(--ink-500);
  }
  .empty-state__note {
    margin-top: var(--s3);
    color: var(--ink-700);
  }
</style>