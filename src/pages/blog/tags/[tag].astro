---
// TRACE PAPER tag index — /blog/tags/[tag] (PLAN §4.1, M4.1).
// Per-tag static pages, static-host safe: getStaticPaths() enumerates
// every distinct (lowercase-normalized) tag from the non-draft posts
// collection and the build emits one /blog/tags/<tag>/ page per tag.
// No query strings, no client JS — the filter is baked per page, so
// GitHub Pages serves exactly this tag's posts.
//
// Template: mono-caps "TAG — <tag>" heading, post count, the shared
// tag chips (current tag active), PostCard ledger scoped to this tag,
// and a link back to /blog. The "NO SUCH MEASUREMENT" empty state
// stays in the template for safety; because getStaticPaths only emits
// pages for real tags, unknown tags 404 to the styled 404 page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  const tagSet = new Set<string>();
  for (const p of posts) {
    for (const t of p.data.tags) tagSet.add(t.toLowerCase());
  }
  return [...tagSet]
    .sort((a, b) => a.localeCompare(b))
    .map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;

const allPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = allPosts.filter((p) =>
  p.data.tags.some((t) => t.toLowerCase() === tag),
);

const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.data.tags) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b));

const tagHref = (t: string) =>
  `/blog/tags/${encodeURIComponent(t.toLowerCase())}/`;
const resetHref = '/blog/';
---
<BaseLayout
  title={`Journal — ${tag} · TRACE PAPER`}
  current="journal"
  description={`Notes tagged “${tag}” — TRACE PAPER journal.`}
>
  <div class="page">
    <header class="tag-head">
      <p class="mono-label">Journal · Tag index</p>
      <h1 class="tag-head__title">TAG — {tag}</h1>
      <p class="tag-head__count mono-label">
        {posts.length} {posts.length === 1 ? 'POST' : 'POSTS'}
      </p>
      <a class="mono-link" href={resetHref}>All posts →</a>
    </header>

    <nav class="tag-filter" aria-label="Filter journal by tag">
      <a class="tag-chip" href={resetHref}>All posts</a>
      {allTags.map((t) => (
        <a
          class={t === tag ? 'tag-chip tag-chip--active' : 'tag-chip'}
          href={tagHref(t)}
        >
          {t} <span class="tag-chip__count tnum">×{tagCounts.get(t)}</span>
        </a>
      ))}
    </nav>

    {posts.length > 0 ? (
      <div class="ledger">
        <div class="ledger__head">
          <span class="ledger__caption">POST / DATE / TAG</span>
        </div>
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            href={`/blog/${post.id}/`}
            tagHref={tagHref}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p class="empty-state__code mono-label">NO SUCH MEASUREMENT</p>
        <p class="empty-state__note">
          No posts tagged “{tag}”. <a href={resetHref}>Show all posts →</a>
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .tag-head {
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--hairline);
  }
  .tag-head .mono-label {
    display: block;
    margin-bottom: var(--s1);
  }
  .tag-head__title {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-600);
    margin-top: var(--s3);
  }
  .tag-head__count {
    margin-top: var(--s2);
    color: var(--ink-700);
  }
  .tag-head .mono-link {
    display: inline-block;
    margin-top: var(--s3);
  }

  .mono-link {
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-600); /* §3.1: links are accent-600, never 500 */
    text-decoration: none;
    transition: color 160ms ease;
  }
  .mono-link:hover {
    color: var(--accent-700);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    padding: var(--s4) 0 var(--s2);
    border-bottom: 1px solid var(--hairline);
  }
  .tag-chip {
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-700);
    text-decoration: none;
    border: 1px solid var(--hairline-2);
    border-radius: var(--r-sm);
    padding: 0.4em 0.7em;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .tag-chip:hover {
    color: var(--accent-600);
    border-color: var(--accent-600);
  }
  .tag-chip--active {
    color: var(--accent-600);
    border-color: var(--accent-600);
  }
  .tag-chip__count {
    color: var(--ink-500);
    margin-left: 0.35em;
  }

  .ledger {
    margin-top: var(--s2);
  }
  .ledger__caption {
    grid-column: 1 / -1; /* single spanning caption over the row grid */
  }

  .empty-state {
    padding: var(--s8) var(--s4);
    text-align: center;
  }
  .empty-state__code {
    color: var(--ink-500);
  }
  .empty-state__note {
    margin-top: var(--s3);
    color: var(--ink-700);
  }
</style>