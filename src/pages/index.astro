---
// Personal site home — / (R1): one screen, stencil-style sparse.
// Centered stack: mono micro-label · huge "Roby Attoillah" (title-case)
// · TraceLine · mono-caps BLOG · ABOUT row. Nothing else — no hero
// paragraph, no latest posts, no résumé teaser, no scroll.
import BaseLayout from '../layouts/BaseLayout.astro';
import TraceLine from '../components/TraceLine.astro';
---
<BaseLayout>
  <section class="home">
    <div class="home__inner">
      <p class="home__kick mono-label">AI Engineer</p>
      <h1 class="home__name">Roby Attoillah</h1>
      <TraceLine label="Trace — Roby Attoillah" />
      <nav class="home__links" aria-label="Site">
        <a href="/blog/">Blog</a>
        <span class="home__dot" aria-hidden="true">·</span>
        <a href="/about/">About</a>
      </nav>
    </div>
  </section>
</BaseLayout>