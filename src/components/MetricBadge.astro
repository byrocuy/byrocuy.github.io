---
// Personal site MetricBadge — one headline measurement on the
// about trace-dashboard: a big Space Grotesk value + mono-caps label
// in a hairline card with a trace accent rule (accent-500 decorative).
// Props:
//   value     — the number, e.g. "10s → 2s", "75%", "26.4B+"
//   label     — mono caps caption, e.g. "P50 first-token latency"
//   dataValue — optional canonical digit string emitted as data-value
//               (client-free microdata; e.g. "26,400+" → "26400")
interface Props {
  value: string;
  label: string;
  dataValue?: string;
}

const { value, label, dataValue } = Astro.props;
---
<div class="metric-badge" data-value={dataValue}>
  <span class="metric-badge__value tnum">{value}</span>
  <span class="metric-badge__label">{label}</span>
</div>