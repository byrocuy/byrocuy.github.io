---
// TRACE PAPER nav — sticky, hairline bottom (§3.4).
// Left: trace-spike glyph in a bordered square + mono-caps wordmark.
// Right: mono-caps links (Journal / Résumé) + GitHub / LinkedIn icons.
// Mobile: same row, horizontal scroll, no hamburger.
interface Props {
  /** Which primary link marks aria-current="page". */
  current?: 'journal' | 'resume';
}

const { current } = Astro.props;

const primary = [
  { id: 'journal', href: '/blog/', label: 'Journal' },
  { id: 'resume', href: '/resume/', label: 'Résumé' },
] as const;

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/byrocuy',
    path: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.6-1.4-5.6-6.1 0-1.4.5-2.5 1.3-3.4-.1-.3-.6-1.6.1-3.4 0 0 1.1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.8.2 3.1.1 3.4.8.9 1.3 2 1.3 3.4 0 4.7-2.9 5.8-5.6 6.1.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/roby-attoillah',
    path: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z',
  },
];
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="TRACE PAPER — home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect class="bm-box" x="2.5" y="2.5" width="19" height="19" rx="3.5" stroke-width="1.5" />
          <path
            class="bm-trace"
            d="M5.5 16.5 C8.5 16.5, 9.5 11.5, 12 11.5 C14 11.5, 15 14.5, 16.2 13.2 L17.6 13.2 v2.2 h2.2 v-2.2"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </span>
      <span class="brand-word">Roby&nbsp;Attoillah</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        primary.map((l) => (
          <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      {
        socials.map((s) => (
          <a class="nav-icon" href={s.href} aria-label={s.label} rel="me" target="_blank">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
</header>