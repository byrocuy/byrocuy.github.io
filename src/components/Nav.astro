---
// Personal site nav (R1) — sticky, hairline bottom.
// Left: mono-caps wordmark "ROBY ATTOILLAH". Right: mono-caps links
// (Blog / About). No GitHub/LinkedIn icons — those move to About.
// Mobile: same row, horizontal scroll, no hamburger.
interface Props {
  /** Which primary link marks aria-current="page". */
  current?: 'blog' | 'about';
}

const { current } = Astro.props;

const primary = [
  { id: 'blog', href: '/blog/', label: 'Blog' },
  { id: 'about', href: '/about/', label: 'About' },
] as const;
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="ROBY ATTOILLAH — home">
      <span class="brand-word">Roby&nbsp;Attoillah</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        primary.map((l) => (
          <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>