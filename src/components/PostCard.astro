---
// Personal site PostCard — ledger row (R1).
// mono date (left) · Space Grotesk title + one-line description;
// hover = hairline→accent border + TraceLine underline. No tags.
import TraceLine from './TraceLine.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  /** Minutes, computed by the caller from the post body (~220 wpm). */
  readingTime?: number;
  /** Absolute path to the post page, e.g. `/blog/ttft-not-price/`. */
  href: string;
}

const { title, description, date, readingTime, href } = Astro.props;

// Instrument-style date: YYYY-MM-DD (en-CA locale), tabular numerals.
const dateStr = date.toLocaleDateString('en-CA');
const iso = date.toISOString();
---
<a class="post-card" href={href}>
  <span class="post-card__date-col">
    <time class="post-card__date tnum" datetime={iso}>{dateStr}</time>
    {readingTime && <span class="post-card__read">~{readingTime} min read</span>}
  </span>
  <span class="post-card__main">
    <span class="post-card__title">{title}</span>
    <span class="post-card__desc">{description}</span>
    <TraceLine label={`Trace — ${title}`} />
  </span>
</a>