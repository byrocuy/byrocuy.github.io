---
// Personal site Badge — thin wrapper over the .badge CSS in
// components.css: mono caps 11px, hairline border, --r-sm, no fill.
// Props:
//   label  — badge text
//   accent — text flips to the lighter vermilion (--accent-400).
interface Props {
  label: string;
  accent?: boolean;
}

const { label, accent = false } = Astro.props;
---
<span class={accent ? 'badge badge--accent' : 'badge'}>{label}</span>