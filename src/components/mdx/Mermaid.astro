---
// Personal site Mermaid — client-side-only diagram rendering.
// mermaid is NOT wired into the build (no remark/rehype mermaid plugin):
// this component ships a lazy `await import('mermaid')` in a plain page
// script, so the mermaid bundle only loads on posts that use <Mermaid>
// (and only where extensions.mermaid is set — gated in /blog/[slug].astro).
//
// Honors prefers-reduced-motion the simple way: no animation config is ever
// applied (sequence/flow diagrams render static by default), so there is
// nothing to suppress. The raw diagram source is served as a <pre> fallback
// in the HTML; if JS loads, the rendered SVG replaces it in place.
interface Props {
  /** Raw mermaid diagram source passed in the code prop. */
  code: string;
  /** Accessible name for the rendered diagram. */
  caption?: string;
}

const { code, caption = 'Diagram' } = Astro.props;
---
<div class="mermaid" role="img" aria-label={caption}>
  <pre class="mermaid-fallback">{code}</pre>
</div>

<script>
  // Lazy, client-side-only: bundles mermaid in its own chunk.
  const containers = document.querySelectorAll('.mermaid');

  if (containers.length > 0) {
    const { default: mermaid } = await import('mermaid');

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'neutral',
      // Dark palette so diagrams read as part of the site.
      themeVariables: {
        fontFamily: "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
        background: '#131314',
        primaryColor: '#1A1A1C',
        primaryBorderColor: '#33333C',
        primaryTextColor: '#EDEDE9',
        lineColor: '#33333C',
        secondaryColor: '#131314',
        tertiaryColor: '#3A1A12',
        actorBkg: '#1A1A1C',
        actorBorder: '#33333C',
        actorTextColor: '#EDEDE9',
        actorLineColor: '#33333C',
        signalColor: '#33333C',
        signalTextColor: '#EDEDE9',
        labelBoxBkgColor: '#3A1A12',
        labelBoxBorderColor: '#E6492B',
        noteBkgColor: '#1A1A1C',
        noteBorderColor: '#47474E',
        sequenceNumberColor: '#82828A',
      },
    });

    for (const [i, el] of [...containers].entries()) {
      const source = el.querySelector('.mermaid-fallback')?.textContent ?? '';
      try {
        const { svg } = await mermaid.render(`trace-mermaid-${i}`, source);
        el.innerHTML = svg;
      } catch {
        // Leave the source <pre> visible and readable if rendering fails.
      }
    }
  }
</script>