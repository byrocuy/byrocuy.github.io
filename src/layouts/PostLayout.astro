---
// TRACE PAPER post template — wraps every /blog/[slug] page (PLAN §4.1, M5).
// Extends BaseLayout: mono-caps "JOURNAL" breadcrumb, Fraunces H1 with the
// signature TraceLine directly beneath it (label = post title), a mono meta
// row (pubDate / updated / reading time), tag Badges linking to the per-tag
// static pages, and prev/next post links (pubDate-ordered) at the bottom.
//
// Math (§6): katex CSS is imported HERE and only here — and only when the
// post opts in (extensions.math). The `?url` + named-slot trick keeps the
// stylesheet a plain <link> in <head> on exactly the pages that need it;
// non-post pages (BaseLayout alone) never pay for math CSS.
import BaseLayout from './BaseLayout.astro';
import TraceLine from '../components/TraceLine.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updated?: Date;
  /** Minutes, computed from the post body at ~220 wpm (word count). */
  readingTime: number;
  tags: string[];
  /** extensions.math — gates the katex stylesheet <link>. */
  math?: boolean;
  /** Absolute canonical URL handed to BaseLayout (og basics too). */
  canonical?: string | URL;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const {
  title,
  description,
  pubDate,
  updated,
  readingTime,
  tags,
  math = false,
  canonical,
  prev,
  next,
} = Astro.props;

const katexCss = math ? (await import('katex/dist/katex.min.css?url')).default : undefined;

// Instrument dates: YYYY-MM-DD (en-CA locale), tabular numerals.
const dateStr = pubDate.toLocaleDateString('en-CA');
const updatedStr = updated ? updated.toLocaleDateString('en-CA') : undefined;
const iso = pubDate.toISOString();
const updatedIso = updated ? updated.toISOString() : undefined;

const tagHref = (tag: string) => `/blog/tags/${encodeURIComponent(tag.toLowerCase())}/`;
---
<BaseLayout
  title={`${title} — TRACE PAPER`}
  description={description}
  current="journal"
  ogType="article"
  canonical={canonical}
>
  {katexCss && <link rel="stylesheet" slot="head" href={katexCss} />}

  <article class="post page">
    <header class="post__head">
      <nav class="post__crumb" aria-label="Breadcrumb">
        <a class="post__crumb-link" href="/blog/">Journal</a>
        <span class="post__crumb-sep" aria-hidden="true">/</span>
        <span class="post__crumb-cur">Post</span>
      </nav>

      <h1 class="post__title">{title}</h1>
      <TraceLine label={`Trace — ${title}`} />

      <p class="post__meta mono-label">
        <time class="tnum" datetime={iso}>Published {dateStr}</time>
        {updatedStr && updatedIso && (
          <span class="post__meta-sep" aria-hidden="true">·</span>
        )}
        {updatedStr && updatedIso && (
          <time class="tnum" datetime={updatedIso}>Updated {updatedStr}</time>
        )}
        <span class="post__meta-sep" aria-hidden="true">·</span>
        <span class="tnum">{readingTime} min read</span>
      </p>

      {tags.length > 0 && (
        <ul class="post__tags">
          {tags.map((tag) => (
            <li class="post__tag">
              <a class="badge" href={tagHref(tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post__pager" aria-label="Post navigation">
      {prev ? (
        <a class="post__pager-link" href={prev.href}>
          <span class="post__pager-kicker mono-label">← Older</span>
          <span class="post__pager-title">{prev.title}</span>
        </a>
      ) : (
        <span class="post__pager-empty" aria-hidden="true" />
      )}
      {next ? (
        <a class="post__pager-link post__pager-link--next" href={next.href}>
          <span class="post__pager-kicker mono-label">Newer →</span>
          <span class="post__pager-title">{next.title}</span>
        </a>
      ) : (
        <span class="post__pager-empty" aria-hidden="true" />
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--measure-page);
  }

  /* ——— Breadcrumb: mono-caps, home link accent-600 (§3.1 contrast rule) ——— */
  .post__crumb {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: var(--label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }
  .post__crumb-link {
    color: var(--accent-600);
    text-decoration: none;
  }
  .post__crumb-link:hover {
    color: var(--accent-700);
  }
  .post__crumb-sep {
    color: var(--ink-300);
  }

  /* ——— H1: Fraunces, article size (step-4 fluid token), TraceLine beneath ——— */
  .post__head {
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--s6);
  }
  .post__title {
    margin-top: var(--s3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink-900);
    text-wrap: balance;
  }
  .post__head .trace-line {
    margin-top: var(--s4);
    max-width: 30rem;
  }

  /* ——— Meta row: mono, tabular dates, muted ——— */
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s3);
    margin-top: var(--s4);
    align-items: baseline;
  }
  .post__meta-sep {
    color: var(--ink-300);
  }

  /* ——— Tags: Badge links to static per-tag pages ——— */
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    margin-top: var(--s4);
    padding: 0;
    list-style: none;
  }
  .post__tags a.badge {
    text-decoration: none;
  }
  .post__tags a.badge:hover,
  .post__tags a.badge:focus-visible {
    color: var(--accent-600);
    border-color: var(--accent-600);
  }

  /* H1 sits outside .prose, so the first heading inside the body needs a
     small top nudge to keep rhythm after the header rule. */
  .prose > h2:first-child {
    margin-top: var(--s4);
  }

  /* ——— Prev / next: ledger-style hairline rows at the bottom ——— */
  .post__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s4);
    margin-top: var(--s8);
    padding-top: var(--s5);
    border-top: 1px solid var(--hairline-2);
  }
  .post__pager-link {
    display: block;
    padding: var(--s3) var(--s4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .post__pager-link:hover,
  .post__pager-link:focus-visible {
    border-color: var(--accent-600);
  }
  .post__pager-link--next {
    text-align: right;
  }
  .post__pager-kicker {
    display: block;
    color: var(--ink-500);
  }
  .post__pager-title {
    display: block;
    margin-top: var(--s1);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink-900);
  }

  @media (max-width: 40rem) {
    .post__pager {
      grid-template-columns: 1fr;
    }
    .post__pager-link--next {
      text-align: left;
    }
  }
</style>